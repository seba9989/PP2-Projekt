# Doxyfile 1.13+ configuration for Arkanoid project

# Projekt
PROJECT_NAME        = "Arkanoid"
PROJECT_BRIEF       = "Gra Arkanoid napisana w C11 z u\u017cyciem raylib"
PROJECT_NUMBER      = 1.0

# Wyj\u015bcie
OUTPUT_DIRECTORY    = docs/
HTML_OUTPUT         = html

# \u0179r\u00f3d\u0142a
INPUT               = ./src ./docs
RECURSIVE           = YES

# Generowanie
GENERATE_HTML       = YES
GENERATE_LATEX      = NO

# Wyci\u0105ganie dokumentacji
EXTRACT_ALL         = YES
EXTRACT_STATIC      = YES
EXTRACT_PRIVATE     = NO
INLINE_SOURCES      = NO
SOURCE_BROWSER      = YES

# Wygl\u0105d HTML
GENERATE_TREEVIEW   = YES
DISABLE_INDEX       = NO
FULL_SIDEBAR        = NO

# Sortowanie
CASE_SENSE_NAMES    = YES
SORT_MEMBER_DOCS    = YES
SORT_BRIEF_DOCS     = NO

# J\u0119zyk
OUTPUT_LANGUAGE     = Polish

# Optymalizacje dla C
SHOW_FILES          = YES
SHOW_NAMESPACES     = NO
TYPEDEF_HIDES_STRUCT = YES

# Graphviz (opcjonalnie)
HAVE_DOT            = NO
